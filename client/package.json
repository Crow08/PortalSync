{
  "name": "portalsync-client",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --watch --configuration development",
    "startProd": "ng serve --host 0.0.0.0 --allowed-hosts=true --configuration production",
    "build": "ng build --configuration production --base-href /portalsync-server/",
    "buildServer": "ng build --configuration production --base-href / && node scripts/copy-to-server.mjs",
    "lint": "ng lint",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@stomp/rx-stomp": "^2.4.0",
    "@stomp/stompjs": "^7.5.0",
    "class-transformer": "^0.5.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "uuid": "^14.0.3",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "angular-eslint": "^22.6.0",
    "bcryptjs": "^3.0.3",
    "eslint": "^10.14.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "vite": "8.3.5"
  }
}
