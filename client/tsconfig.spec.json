/* The unit tests (the .spec.ts files in src, Vitest through the Angular builder: npm test). The e2e tests have their own in e2e. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"]
}
