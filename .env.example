# Copy to .env (not committed) and fill in. Used by compose.yaml.

# Database. Choose your own passwords.
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Signs the media URLs (neverpile url-crypto). Required, use a long random string, e.g. `openssl rand -hex 32`.
URLCRYPTO_SECRET=

# The address users open, with scheme and without a trailing slash. It is the only origin allowed for CORS and the
# WebSocket. For the "tls" profile this is https://<PORTALSYNC_DOMAIN>.
CLIENT_ORIGIN=http://localhost:8080

# Folder with the media library, mounted at /media. Relative paths are relative to this folder.
MEDIA_DIR=./media

# Published port of the app; APP_BIND=0.0.0.0 makes it reachable from the network.
APP_PORT=8080
APP_BIND=127.0.0.1

# Spotify (optional). The redirect URI has to be registered in the Spotify dashboard and must be HTTPS (or a loopback IP);
# empty means CLIENT_ORIGIN + /spotify/redirect.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Only for `docker compose --profile tls`: the host name Caddy gets a certificate for.
# PORTALSYNC_DOMAIN=music.example.org
